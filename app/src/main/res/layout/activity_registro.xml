<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/boca_azul">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_registro"
            android:textColor="@color/boca_oro"
            android:textStyle="bold"
            android:textSize="28sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/edtEmailRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:background="@color/boca_azul_tarjeta"/>

        <EditText
            android:id="@+id/edtPasswordRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:background="@color/boca_azul_tarjeta"/>

        <EditText
            android:id="@+id/edtRepetirPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_repetir_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:background="@color/boca_azul_tarjeta"/>

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/registrar"
            android:textColor="@color/boca_azul"
            android:textStyle="bold"
            android:backgroundTint="@color/boca_oro"/>

        <Button
            android:id="@+id/btnVolverRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/volver"
            android:textColor="@color/boca_oro"
            android:textStyle="bold"
            android:backgroundTint="@color/boca_azul_tarjeta"/>

    </LinearLayout>
</ScrollView>
